#Использовать prometheus

// BSLLS:ExportVariables-off

// Демо-счётчик запросов к /metrics (создаётся один раз при создании контроллера).
Перем СчетчикЗапросовМетрик Экспорт;
// Демо-индикатор prometheus_client_up (1 = запущено).
Перем ИндикаторПриложения Экспорт;

// BSLLS:ExportVariables-on

// Контроллер по пути /metrics - не конфликтует с корневым контроллером при встраивании в проект.
&Контроллер("/metrics")
Процедура ПриСозданииОбъекта()
	ЛейблыЗапросов = Новый Соответствие;
	ЛейблыЗапросов.Вставить("handler", "/metrics");
	СчетчикЗапросовМетрик = Prometheus.НовыйСчетчик(
		"prometheus_client_http_requests_total",
		"Число HTTP-запросов к эндпоинту выдачи метрик",
		ЛейблыЗапросов);
	ИндикаторПриложения = Prometheus.НовыйИндикатор(
		"prometheus_client_up",
		"Клиент Prometheus: приложение отвечает (1)");
	Prometheus.Установить(ИндикаторПриложения, 1);
КонецПроцедуры

// Единственная точка маршрута: GET /metrics отдаёт текст метрик.
// Параметры:
//   Ответ - Объект - объект ответа Winow; заполняется телом и заголовками.
&ТочкаМаршрута("")
Процедура ОтдатьМетрики(Ответ) Экспорт
	Prometheus.Инкремент(СчетчикЗапросовМетрик);

	Семейства = Prometheus.СобратьМетрики();
	Текст = Prometheus.СериализоватьВТекст(Семейства);

	// text/plain ("txt"), иначе text/html - тело в браузере пусто.
	Ответ.УстановитьТипКонтента("txt");
	Ответ.Заголовки["Content-Type"] = Prometheus.ContentTypeМетрик();
	Ответ.ТелоТекст = Текст;
КонецПроцедуры
